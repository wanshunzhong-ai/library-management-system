# 图书管理系统 · 环境变量示例
# 复制为 .env 并按需修改；所有变量都有合理默认值，不设置也能直接跑。

# 数据库文件路径（默认 ./data/library.db）
LIBRARY_DB_PATH=./data/library.db

# 监听地址与端口
LIBRARY_HOST=127.0.0.1
LIBRARY_PORT=8000

# 调试模式（生产环境务必 false）
LIBRARY_DEBUG=false

# ---- 借阅规则 ----
# 单次借期（天）
LIBRARY_LOAN_DAYS=30
# 最大续借次数
LIBRARY_MAX_RENEW=2
# 逾期罚金（元/天）
LIBRARY_FINE_PER_DAY=0.50
# 罚金封顶（均按「每笔借阅」计，0 表示该维度不限制；两者取先到者）
# 最长计息天数：逾期再久也只按这么多天计费
LIBRARY_FINE_MAX_DAYS=365
# 单笔罚金上限（元）
LIBRARY_FINE_CAP=50.00
# 新读者默认可借上限
LIBRARY_DEFAULT_MAX_BORROW=5
# 预约到书保留期（天）：预约转为「已到书」后，超过这么多天仍未借出则自动过期释放。
# 到期释放是**惰性扫描**（读者打开通知中心 / 概览时触发，无定时任务），见 README「已知限制」。
LIBRARY_RESERVATION_HOLD_DAYS=3
# 「即将到期」提醒口径（天）：读者通知中心据此判定「快到还书日」；0 表示关闭该类提醒。
LIBRARY_NOTIFY_DUE_SOON_DAYS=3

# ---- 后台定时扫描 ----
# 预约过期释放 + 到期/逾期提醒的后台扫描间隔（秒）。0 表示**不启动后台线程**，
# 退回「有人打开页面时惰性扫描」的模式（单元测试即用 0，避免每个用例都起线程）。
# 多实例部署时两条扫描都是幂等的，重复执行只是几次空查询；真要严格只跑一次，
# 应改由外部调度（cron / Celery beat）调用。
LIBRARY_SWEEP_INTERVAL_SECONDS=600

# ---- 读者附件（照片 / 证件影像）----
# 上传根目录，留空 = 数据库所在目录下的 uploads/（便于随数据一起备份 / 迁移）。
LIBRARY_UPLOAD_DIR=
# 单个附件的体积上限（MB，1–50）。同时决定请求体上限为 (该值 + 1)MB。
LIBRARY_UPLOAD_MAX_MB=4

# ---- 邮件出站渠道（SMTP，选配）----
# 站内通知之外的第二条触达路径：读者需留有邮箱且未退订，同一业务事件会同步入队一封邮件。
# HOST 留空 = 未配置渠道：消息照常入队但停在「待发送」，配置好后由后台扫描自动补发。
LIBRARY_SMTP_HOST=
# 端口留空或填 0 = 按加密方式自动选择（SSL 用 465、STARTTLS 用 587）
LIBRARY_SMTP_PORT=0
LIBRARY_SMTP_USER=
LIBRARY_SMTP_PASSWORD=
# 发件人地址，留空取 SMTP_USER
LIBRARY_SMTP_FROM=
# 加密方式：auto（按端口推断）/ ssl / tls / none
LIBRARY_SMTP_SECURE=auto

# ---- 内控：罚金减免审批 ----
# 单笔减免金额达到该值（元）时不再直接生效，转「审批中心」由系统管理员批准。
# 0（默认）= 不启用审批，减免直接生效（适合同一小馆的日常操作）。
LIBRARY_APPROVAL_WAIVER_THRESHOLD=0

# ---- 数据备份 ----
# 备份目录，留空 = 数据库所在目录下的 backups/。
# 备份用 SQLite 在线备份 API 做一致性快照，可热备；命令：python app.py backup [--with-uploads]
# 恢复须停服执行：python app.py restore --from backups/library-YYYYmmdd-HHMMSS.db
LIBRARY_BACKUP_DIR=

# ---- 站点与鉴权 ----
# 馆名与标语（显示在读者门户）
LIBRARY_NAME=星海图书馆
LIBRARY_SLOGAN=让每一本书都找到它的读者
# 首次启动时创建的默认管理员（之后以数据库为准，请登录后立即改密）
# 仍在使用默认口令时，启动日志与后台控制台都会给出醒目提示
LIBRARY_ADMIN_USER=admin
LIBRARY_ADMIN_PASSWORD=admin123
# 会话有效期（小时）
LIBRARY_SESSION_HOURS=8
# 登录失败限流：连续失败 N 次锁定 M 分钟
LIBRARY_LOGIN_MAX_ATTEMPTS=5
LIBRARY_LOGIN_LOCK_MINUTES=5
# 访客免登录写接口（在线办证提交）的 IP 限流：连续失败 N 次锁定 M 分钟。
# 借阅速查不单独设桶 —— 它的失败计数直接复用上面的登录限流，防止绕过登录锁定。
LIBRARY_APPLY_MAX_ATTEMPTS=10
LIBRARY_APPLY_LOCK_MINUTES=10
# 启用 HTTPS 后设为 true，会话 Cookie 将标记 Secure
LIBRARY_COOKIE_SECURE=false
# 受信反向代理（IP 或 CIDR，逗号分隔）。
# 只有来自这些地址的请求才采信 X-Forwarded-For —— 否则任何人都能靠伪造
# 该请求头换一个限流桶，登录锁定将形同虚设。直连部署留空即可。
LIBRARY_TRUSTED_PROXIES=

# ---- 可观测性与安全 ----
LIBRARY_LOG_LEVEL=INFO
# 会话签名密钥。留空则自动生成随机密钥并保存到数据目录的 .secret_key（推荐）。
# 显式配置时必须足够随机（≥16 字符）；填示例值/弱值会在生产模式下拒绝启动
# —— 密钥可预测意味着任何人都能伪造管理员会话。
LIBRARY_SECRET_KEY=
# 跨域白名单（逗号分隔）；同源部署留空即可
LIBRARY_CORS_ORIGINS=
