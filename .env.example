# 图书管理系统 · 环境变量示例
# 复制为 .env 并按需修改；所有变量都有合理默认值，不设置也能直接跑。

# 数据库文件路径（默认 ./data/library.db）
LIBRARY_DB_PATH=./data/library.db

# 监听地址与端口
LIBRARY_HOST=127.0.0.1
LIBRARY_PORT=8000

# 调试模式（生产环境务必 false）
LIBRARY_DEBUG=false

# ---- 借阅规则 ----
# 单次借期（天）
LIBRARY_LOAN_DAYS=30
# 最大续借次数
LIBRARY_MAX_RENEW=2
# 逾期罚金（元/天）
LIBRARY_FINE_PER_DAY=0.50
# 罚金封顶（均按「每笔借阅」计，0 表示该维度不限制；两者取先到者）
# 最长计息天数：逾期再久也只按这么多天计费
LIBRARY_FINE_MAX_DAYS=365
# 单笔罚金上限（元）
LIBRARY_FINE_CAP=50.00
# 新读者默认可借上限
LIBRARY_DEFAULT_MAX_BORROW=5

# ---- 站点与鉴权 ----
# 馆名与标语（显示在读者门户）
LIBRARY_NAME=星海图书馆
LIBRARY_SLOGAN=让每一本书都找到它的读者
# 首次启动时创建的默认管理员（之后以数据库为准，请登录后立即改密）
# 仍在使用默认口令时，启动日志与后台控制台都会给出醒目提示
LIBRARY_ADMIN_USER=admin
LIBRARY_ADMIN_PASSWORD=admin123
# 会话有效期（小时）
LIBRARY_SESSION_HOURS=8
# 登录失败限流：连续失败 N 次锁定 M 分钟
LIBRARY_LOGIN_MAX_ATTEMPTS=5
LIBRARY_LOGIN_LOCK_MINUTES=5
# 启用 HTTPS 后设为 true，会话 Cookie 将标记 Secure
LIBRARY_COOKIE_SECURE=false
# 受信反向代理（IP 或 CIDR，逗号分隔）。
# 只有来自这些地址的请求才采信 X-Forwarded-For —— 否则任何人都能靠伪造
# 该请求头换一个限流桶，登录锁定将形同虚设。直连部署留空即可。
LIBRARY_TRUSTED_PROXIES=

# ---- 可观测性与安全 ----
LIBRARY_LOG_LEVEL=INFO
# 会话签名密钥。留空则自动生成随机密钥并保存到数据目录的 .secret_key（推荐）。
# 显式配置时必须足够随机（≥16 字符）；填示例值/弱值会在生产模式下拒绝启动
# —— 密钥可预测意味着任何人都能伪造管理员会话。
LIBRARY_SECRET_KEY=
# 跨域白名单（逗号分隔）；同源部署留空即可
LIBRARY_CORS_ORIGINS=
